{
  "name": "forfontsake",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:font": "tsx scripts/build-font.ts",
    "build:share": "tsx scripts/make-share-image.ts",
    "build:workbench": "tsx scripts/make-glyph-data.ts && cp out/glyph-data.json public/glyph-data.json && vite build --mode artifact && tsx scripts/inline-build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "verify:font": "node scripts/verify-font.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "clipper2-ts": "^2.0.1-18",
    "d3-delaunay": "^6.0.4",
    "font-flux-js": "^2.7.2",
    "jszip": "^3.10.1",
    "opentype.js": "^2.0.0",
    "poisson-disk-sampling": "^2.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^24.13.3",
    "@types/opentype.js": "^1.3.10",
    "@types/poisson-disk-sampling": "^2.2.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "license": "GPL-3.0-only",
  "description": "Interactive type foundry — apply parametric treatments to a font and export a real, installable, correctly-licensed derivative."
}
